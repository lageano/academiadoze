<?xml version="1.0" encoding="utf-8" ?>
<!-- gabriel geremias vieira -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AlunoPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
             x:DataType="vm:AlunoViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSource" />
        <converters:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12" MaximumWidthRequest="860">

            <Label Text="Dados Pessoais" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="2">

                    <Label Text="Nome completo" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Aluno.Nome}" Placeholder="Nome completo do aluno" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="CPF" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Aluno.Cpf}" Placeholder="Somente números" Keyboard="Numeric" MaxLength="14" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Data de nascimento" Style="{StaticResource FieldLabel}" />
                            <DatePicker Date="{Binding Aluno.DataNascimento, Converter={StaticResource DateOnlyToDateTime}}" Format="dd/MM/yyyy" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Telefone" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Aluno.Telefone}" Placeholder="DDD + número" Keyboard="Telephone" MaxLength="15" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="E-mail (opcional)" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Aluno.Email}" Placeholder="email@exemplo.com" Keyboard="Email" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Label Text="Endereço" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="2">

                    <Label Text="Logradouro" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding Logradouros}"
                            ItemDisplayBinding="{Binding Nome}"
                            SelectedItem="{Binding LogradouroSelecionado, Mode=TwoWay}"
                            Title="Selecione o logradouro..." />

                    <Grid ColumnDefinitions="130,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Número" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Aluno.Numero}" Placeholder="Nº" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Complemento (opcional)" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Aluno.Complemento}" Placeholder="Apto, bloco..." />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Label Text="Acesso e Foto" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="2">

                    <Label Text="Senha" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Aluno.Senha}" IsPassword="True"
                           Placeholder="Mínimo 6 caracteres, com letras e números" />
                    <Label Text="Na edição, deixe em branco para manter a senha atual."
                           FontSize="10" IsVisible="{Binding IsEditMode}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,10,0,0">
                        <Border Grid.Column="0" WidthRequest="90" HeightRequest="90" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Image Source="{Binding Aluno.Foto, Converter={StaticResource FotoToImageSource}}"
                                   Aspect="AspectFill" WidthRequest="90" HeightRequest="90" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Button Text="Selecionar Foto"
                                    Style="{StaticResource PrimaryPillButton}"
                                    Command="{Binding SelecionarFotoCommand}" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8">
                <Button Grid.Column="0" Text="{helpers:Translate strCancelar}"
                        Style="{StaticResource GhostPillButton}" Command="{Binding CancelarCommand}" />
                <Button Grid.Column="1" Text="{helpers:Translate strSalvar}"
                        Style="{StaticResource PrimaryPillButton}"
                        IsEnabled="{Binding IsNotBusy}" Command="{Binding SalvarCommand}" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
