<?xml version="1.0" encoding="utf-8" ?>
<!-- gabriel geremias vieira -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AlunoPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             x:DataType="vm:AlunoViewModel"
             Title=""
             Shell.NavBarIsVisible="{OnPlatform Default=True, WinUI=False}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSource" />
        <converters:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
        <converters:IniciaisConverter x:Key="Iniciais" />
        <converters:NomeParaCorConverter x:Key="NomeParaCor" />
        <converters:SemFotoConverter x:Key="SemFoto" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,1,*,1,Auto">

        <VerticalStackLayout Grid.Row="0" Padding="{OnIdiom Phone='20,20,20,16', Default='36,26,36,20'}" Spacing="3"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}">
            <Label Text="{Binding Title}" Style="{StaticResource TituloTela}" />
            <Label Text="Dados cadastrais, endereço e credenciais de acesso." Style="{StaticResource LinhaApoio}" />
        </VerticalStackLayout>

        <BoxView Grid.Row="1" Style="{StaticResource Separador}" />

        <ScrollView Grid.Row="2">
            <Grid ColumnDefinitions="{OnIdiom Phone='*,0', Default='*,280'}" ColumnSpacing="40"
                  RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto,0'}"
                  Padding="{OnIdiom Phone='20,22', Default='36,26'}"
                  MaximumWidthRequest="1100" HorizontalOptions="Start">

                <!-- Campos -->
                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="0" MaximumWidthRequest="720" HorizontalOptions="Start">

                    <Label Text="DADOS PESSOAIS" Style="{StaticResource RotuloSecao}" />

                    <Label Text="NOME COMPLETO" Style="{StaticResource RotuloCampo}" />
                    <Entry Text="{Binding Aluno.Nome}" Placeholder="Nome completo do aluno" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="CPF" Style="{StaticResource RotuloCampo}" />
                            <Entry Text="{Binding Aluno.Cpf}" Placeholder="Somente números" Keyboard="Numeric" MaxLength="14" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="NASCIMENTO" Style="{StaticResource RotuloCampo}" />
                            <DatePicker Date="{Binding Aluno.DataNascimento, Converter={StaticResource DateOnlyToDateTime}}" Format="dd/MM/yyyy" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="TELEFONE" Style="{StaticResource RotuloCampo}" />
                            <Entry Text="{Binding Aluno.Telefone}" Placeholder="DDD + número" Keyboard="Telephone" MaxLength="15" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="E-MAIL (OPCIONAL)" Style="{StaticResource RotuloCampo}" />
                            <Entry Text="{Binding Aluno.Email}" Placeholder="email@exemplo.com" Keyboard="Email" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView Style="{StaticResource Separador}" Margin="0,26" />

                    <Label Text="ENDEREÇO" Style="{StaticResource RotuloSecao}" />

                    <Label Text="LOGRADOURO" Style="{StaticResource RotuloCampo}" />
                    <Picker ItemsSource="{Binding Logradouros}" ItemDisplayBinding="{Binding Nome, x:DataType=dto:LogradouroDto}"
                            SelectedItem="{Binding LogradouroSelecionado, Mode=TwoWay}"
                            Title="Selecione o logradouro..." />

                    <Grid ColumnDefinitions="140,*" ColumnSpacing="20">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="NÚMERO" Style="{StaticResource RotuloCampo}" />
                            <Entry Text="{Binding Aluno.Numero}" Placeholder="Nº" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="COMPLEMENTO (OPCIONAL)" Style="{StaticResource RotuloCampo}" />
                            <Entry Text="{Binding Aluno.Complemento}" Placeholder="Apto, bloco..." />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView Style="{StaticResource Separador}" Margin="0,26" />

                    <Label Text="ACESSO" Style="{StaticResource RotuloSecao}" />

                    <Label Text="SENHA" Style="{StaticResource RotuloCampo}" />
                    <Entry Text="{Binding Aluno.Senha}" IsPassword="True"
                           Placeholder="Mínimo 6 caracteres, com letras e números" />
                    <Label Text="Deixe em branco para manter a senha atual." FontSize="11" Margin="0,6,0,0"
                           IsVisible="{Binding IsEditMode}"
                           TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Start" Margin="0,24,0,0" />
                </VerticalStackLayout>

                <!-- Coluna da foto -->
                <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}"
                                     Margin="{OnIdiom Phone='0,26,0,0', Default=0}" Spacing="14">
                    <Label Text="FOTO" Style="{StaticResource RotuloSecao}" />

                    <Grid WidthRequest="150" HeightRequest="150" HorizontalOptions="Start">
                        <Border WidthRequest="150" HeightRequest="150" StrokeThickness="0"
                                BackgroundColor="{Binding Aluno.Nome, Converter={StaticResource NomeParaCor}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="{Binding Aluno.Nome, Converter={StaticResource Iniciais}}"
                                   Style="{StaticResource AvatarIniciais}" FontSize="46" />
                        </Border>
                        <Border WidthRequest="150" HeightRequest="150" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Image Source="{Binding Aluno.Foto, Converter={StaticResource FotoToImageSource}}"
                                   Aspect="AspectFill" WidthRequest="150" HeightRequest="150" />
                        </Border>
                    </Grid>

                    <Button Text="Selecionar foto" Style="{StaticResource BotaoSecundario}"
                            WidthRequest="150" HorizontalOptions="Start"
                            Command="{Binding SelecionarFotoCommand}" />
                </VerticalStackLayout>

            </Grid>
        </ScrollView>

        <BoxView Grid.Row="3" Style="{StaticResource Separador}" />

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Padding="{OnIdiom Phone='20,12', Default='36,16'}"
              BackgroundColor="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}">
            <Button Grid.Column="1" Text="{helpers:Translate strCancelar}" WidthRequest="130"
                    Style="{StaticResource BotaoSecundario}" Command="{Binding CancelarCommand}" />
            <Button Grid.Column="2" Text="{helpers:Translate strSalvar}" WidthRequest="150"
                    Style="{StaticResource BotaoPrimario}"
                    IsEnabled="{Binding IsNotBusy}" Command="{Binding SalvarCommand}" />
        </Grid>
    </Grid>
</ContentPage>
