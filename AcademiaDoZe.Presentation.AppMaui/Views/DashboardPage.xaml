<?xml version="1.0" encoding="utf-8" ?>
<!-- gabriel geremias vieira -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
             x:DataType="vm:DashboardViewModel"
             Title=""
             Shell.NavBarIsVisible="{OnPlatform Default=True, WinUI=False}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <ContentPage.Resources>
        <!-- Atalho do painel: círculo colorido + rótulo embaixo -->
        <Style x:Key="AtalhoCirculo" TargetType="Border">
            <Setter Property="WidthRequest" Value="56" />
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <Ellipse />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AtalhoGlifo" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="AtalhoTexto" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Faixa de abertura com a logo da aplicação -->
            <Grid HeightRequest="{OnIdiom Phone=130, Default=172}">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Roxo}" Offset="0.0" />
                        <GradientStop Color="{StaticResource RoxoFundo}" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>

                <Image Source="logo_academia.png"
                       Aspect="AspectFit"
                       HeightRequest="{OnIdiom Phone=96, Default=118}"
                       HorizontalOptions="{OnIdiom Phone=Center, Default=Start}"
                       Margin="{OnIdiom Phone='20,0', Default='40,0'}" />
            </Grid>

            <!-- Números em destaque, separados por linhas finas.
                 Em telas estreitas a faixa rola na horizontal em vez de cortar os números. -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}">
            <Grid ColumnDefinitions="{OnIdiom Phone='140,1,140,1,140', Default='190,1,190,1,190'}"
                  ColumnSpacing="{OnIdiom Phone=20, Default=28}"
                  Padding="{OnIdiom Phone='20,22', Default='40,30'}">

                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding TotalAlunos}" FontSize="44" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
                    <Label Text="{helpers:Translate strAluno}" Style="{StaticResource RotuloSecao}" />
                </VerticalStackLayout>

                <BoxView Grid.Column="1" WidthRequest="1" VerticalOptions="Fill"
                         Color="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />

                <VerticalStackLayout Grid.Column="2" Spacing="2">
                    <Label Text="{Binding TotalColaboradores}" FontSize="44" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
                    <Label Text="{helpers:Translate strColaborador}" Style="{StaticResource RotuloSecao}" />
                </VerticalStackLayout>

                <BoxView Grid.Column="3" WidthRequest="1" VerticalOptions="Fill"
                         Color="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />

                <VerticalStackLayout Grid.Column="4" Spacing="2">
                    <Label FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding TotalMatriculasAtivas}" FontSize="44" />
                                <Span Text=" ativas" FontSize="15" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="{helpers:Translate strMatricula}" Style="{StaticResource RotuloSecao}" />
                </VerticalStackLayout>
            </Grid>
            </ScrollView>

            <BoxView Style="{StaticResource Separador}" />

            <!-- Atalhos dos módulos -->
            <VerticalStackLayout Padding="{OnIdiom Phone='20,24,20,10', Default='40,30,40,10'}" Spacing="22">

                <VerticalStackLayout Spacing="4">
                    <Label Text="{helpers:Translate strBemVindo}" Style="{StaticResource TituloTela}" />
                    <Label Text="{helpers:Translate strDashboardDescricao}" Style="{StaticResource LinhaApoio}" />
                </VerticalStackLayout>

                <!-- No celular a fileira de atalhos rola na horizontal -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="{OnIdiom Phone=22, Default=34}"
                      HorizontalOptions="Start">

                    <VerticalStackLayout Grid.Column="0">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavegarCommand}" CommandParameter="acesso" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Border Style="{StaticResource AtalhoCirculo}" BackgroundColor="{StaticResource Roxo}">
                            <Label Text="CA" Style="{StaticResource AtalhoGlifo}" />
                        </Border>
                        <Label Text="{helpers:Translate strAcesso}" Style="{StaticResource AtalhoTexto}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavegarCommand}" CommandParameter="alunos" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Border Style="{StaticResource AtalhoCirculo}" BackgroundColor="#1F8A4C">
                            <Label Text="AL" Style="{StaticResource AtalhoGlifo}" />
                        </Border>
                        <Label Text="{helpers:Translate strAluno}" Style="{StaticResource AtalhoTexto}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavegarCommand}" CommandParameter="colaboradores" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Border Style="{StaticResource AtalhoCirculo}" BackgroundColor="#0E7490">
                            <Label Text="CO" Style="{StaticResource AtalhoGlifo}" />
                        </Border>
                        <Label Text="{helpers:Translate strColaborador}" Style="{StaticResource AtalhoTexto}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="3">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavegarCommand}" CommandParameter="matriculas" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Border Style="{StaticResource AtalhoCirculo}" BackgroundColor="#B45309">
                            <Label Text="MA" Style="{StaticResource AtalhoGlifo}" />
                        </Border>
                        <Label Text="{helpers:Translate strMatricula}" Style="{StaticResource AtalhoTexto}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="4">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavegarCommand}" CommandParameter="logradouros" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Border Style="{StaticResource AtalhoCirculo}" BackgroundColor="#9D174D">
                            <Label Text="LG" Style="{StaticResource AtalhoGlifo}" />
                        </Border>
                        <Label Text="{helpers:Translate strLogradouro}" Style="{StaticResource AtalhoTexto}" />
                    </VerticalStackLayout>
                </Grid>
                </ScrollView>

                <BoxView Style="{StaticResource Separador}" Margin="0,8" />

                <!-- Idioma e atualização -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,20">
                    <Label Grid.Column="0" Text="{helpers:Translate strIdioma}"
                           Style="{StaticResource RotuloSecao}" VerticalOptions="Center" />
                    <Picker Grid.Column="1" ItemsSource="{Binding Idiomas}"
                            MaximumWidthRequest="240" HorizontalOptions="Start"
                            SelectedItem="{Binding IdiomaSelecionado, Mode=TwoWay}" />
                    <Button Grid.Column="2" Text="{helpers:Translate strAtualizar}"
                            Style="{StaticResource BotaoSecundario}"
                            Padding="18,0"
                            Command="{Binding CarregarResumoCommand}" />
                </Grid>

            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,0,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
