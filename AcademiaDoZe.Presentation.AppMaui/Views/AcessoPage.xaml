<?xml version="1.0" encoding="utf-8" ?>
<!-- gabriel geremias vieira -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AcessoPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
             x:DataType="vm:AcessoViewModel"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSource" />
        <converters:AutorizadoToColorConverter x:Key="AutorizadoToColor" />
        <converters:PresencaToTextConverter x:Key="PresencaToText" />
        <converters:InvertedBoolConverter x:Key="InvertedBool" />
        <converters:IniciaisConverter x:Key="Iniciais" />
        <converters:NomeParaCorConverter x:Key="NomeParaCor" />
        <converters:SemFotoConverter x:Key="SemFoto" />
        <converters:ModoSelecionadoCorConverter x:Key="ModoCor" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,360">

        <!-- Cabeçalho -->
        <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Padding="36,28,36,22" Spacing="4"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}">
            <Label Text="Controle de Acesso" Style="{StaticResource TituloTela}" />
            <Label Text="Registre a entrada e a saída de alunos e colaboradores." Style="{StaticResource LinhaApoio}" />
        </VerticalStackLayout>

        <!-- Coluna principal: identificação e liberação -->
        <ScrollView Grid.Row="1" Grid.Column="0">
            <VerticalStackLayout Padding="36,28,28,28" Spacing="26">

                <!-- Alternância de modo em segmentos encostados -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="TIPO DE ACESSO" Style="{StaticResource RotuloSecao}" />
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="0" HorizontalOptions="Start">
                        <Button Grid.Column="0" Text="Aluno" WidthRequest="150" CornerRadius="8"
                                Command="{Binding TrocarModoCommand}" CommandParameter="aluno"
                                BackgroundColor="{Binding ModoAluno, Converter={StaticResource ModoCor}}"
                                IsEnabled="{Binding ModoAluno, Converter={StaticResource InvertedBool}}"
                                TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}"
                                BorderColor="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}"
                                BorderWidth="1" FontAttributes="Bold" HeightRequest="42" />
                        <Button Grid.Column="1" Text="Colaborador" WidthRequest="150" CornerRadius="8" Margin="8,0,0,0"
                                Command="{Binding TrocarModoCommand}" CommandParameter="colaborador"
                                IsEnabled="{Binding ModoAluno}"
                                Style="{StaticResource BotaoSecundario}" />
                    </Grid>
                    <Label Text="{Binding ModoAtualTexto}" FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource Roxo}, Dark={StaticResource Dourado}}" />
                </VerticalStackLayout>

                <BoxView Style="{StaticResource Separador}" />

                <!-- Busca -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="LOCALIZAR PESSOA" Style="{StaticResource RotuloSecao}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0" Placeholder="Nome ou CPF" Text="{Binding TextoBusca}" />
                        <Button Grid.Column="1" Text="Buscar" Style="{StaticResource BotaoPrimario}"
                                WidthRequest="110" Command="{Binding BuscarPessoasCommand}" />
                    </Grid>
                    <Label Text="{Binding RotuloSelecao}" Style="{StaticResource RotuloCampo}" Margin="0,6,0,2" />
                    <Picker ItemsSource="{Binding Pessoas}" ItemDisplayBinding="{Binding Nome}"
                            SelectedItem="{Binding PessoaSelecionada, Mode=TwoWay}"
                            Title="Toque para escolher..." />
                </VerticalStackLayout>

                <!-- Pessoa identificada -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding TemPessoaSelecionada}">
                    <BoxView Style="{StaticResource Separador}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                        <!-- Avatar: foto quando existe, iniciais quando não -->
                        <Grid Grid.Column="0" WidthRequest="60" HeightRequest="60" VerticalOptions="Center">
                            <Border Style="{StaticResource Avatar}" WidthRequest="60" HeightRequest="60"
                                    BackgroundColor="{Binding PessoaSelecionada.Nome, Converter={StaticResource NomeParaCor}}">
                                <Label Text="{Binding PessoaSelecionada.Nome, Converter={StaticResource Iniciais}}"
                                       Style="{StaticResource AvatarIniciais}" FontSize="20" />
                            </Border>
                            <Border Style="{StaticResource Avatar}" WidthRequest="60" HeightRequest="60">
                                <Image Source="{Binding PessoaSelecionada.Foto, Converter={StaticResource FotoToImageSource}}"
                                       Aspect="AspectFill" WidthRequest="60" HeightRequest="60" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding PessoaSelecionada.Nome}" FontSize="19" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
                            <Label Text="{Binding PessoaSelecionada.CpfFormatado}" Style="{StaticResource MetaDado}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="2" Style="{StaticResource Etiqueta}" VerticalOptions="Center">
                            <Label Text="{Binding EstaNaAcademia, Converter={StaticResource PresencaToText}}"
                                   Style="{StaticResource EtiquetaTexto}" />
                        </Border>
                    </Grid>

                    <Button Text="{Binding TextoBotaoAcesso}"
                            Command="{Binding RegistrarAcessoCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource BotaoPrimario}"
                            HeightRequest="52" FontSize="15" />
                </VerticalStackLayout>

                <!-- Resultado: faixa lateral colorida, sem caixa preenchida -->
                <Grid IsVisible="{Binding TemResultado}" ColumnDefinitions="4,*" ColumnSpacing="14">
                    <BoxView Grid.Column="0" VerticalOptions="Fill"
                             Color="{Binding ResultadoAutorizado, Converter={StaticResource AutorizadoToColor}}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="0,4">
                        <Label Text="{Binding TituloResultado}" FontSize="14" FontAttributes="Bold"
                               TextColor="{Binding ResultadoAutorizado, Converter={StaticResource AutorizadoToColor}}" />
                        <Label Text="{Binding MensagemResultado}" Style="{StaticResource MetaDado}" />
                    </VerticalStackLayout>
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Coluna lateral: movimentação do dia -->
        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,1,*"
              BackgroundColor="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="22,22,14,14">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="MOVIMENTAÇÃO DE HOJE" Style="{StaticResource RotuloSecao}" />
                    <Label Text="{Binding AcessosHoje.Count, StringFormat='{0} registro(s)'}" Style="{StaticResource MetaDado}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="{helpers:Translate strAtualizar}"
                        Style="{StaticResource BotaoTexto}"
                        Command="{Binding CarregarAcessosDeHojeCommand}" />
            </Grid>

            <BoxView Grid.Row="1" Style="{StaticResource Separador}" />

            <CollectionView Grid.Row="2" ItemsSource="{Binding AcessosHoje}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="22,44" Spacing="6">
                        <Label Text="Sem movimentação" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />
                        <Label Text="Os acessos registrados hoje aparecem aqui."
                               Style="{StaticResource MetaDado}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AcessoHojeItem">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="22,13">
                                <Border Grid.Column="0" Style="{StaticResource Avatar}" WidthRequest="34" HeightRequest="34"
                                        BackgroundColor="{Binding Nome, Converter={StaticResource NomeParaCor}}">
                                    <Label Text="{Binding Nome, Converter={StaticResource Iniciais}}"
                                           Style="{StaticResource AvatarIniciais}" FontSize="12" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding Nome}" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
                                    <Label Text="{Binding Descricao}" FontSize="11" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2" Text="{Binding Hora}" FontSize="12" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />
                            </Grid>
                            <BoxView Style="{StaticResource Separador}" Margin="22,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

    </Grid>
</ContentPage>
