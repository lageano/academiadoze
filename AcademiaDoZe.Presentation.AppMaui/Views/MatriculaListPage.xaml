<?xml version="1.0" encoding="utf-8" ?>
<!-- gabriel geremias vieira -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaListPage"
             x:Name="MatriculasPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
             x:DataType="vm:MatriculaListViewModel"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <!-- Recursos da Página -->
    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSource" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
        <converters:RestricoesFlagsDisplayConverter x:Key="RestricoesDisplay" />
        <converters:IniciaisConverter x:Key="Iniciais" />
        <converters:NomeParaCorConverter x:Key="NomeParaCor" />
        <converters:SemFotoConverter x:Key="SemFoto" />
    </ContentPage.Resources>

    <!-- Lista de Matrículas -->
    <Grid RowDefinitions="Auto,Auto,1,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="36,26,36,16"
              BackgroundColor="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}">
            <VerticalStackLayout Grid.Column="0" Spacing="3">
                <Label Text="{helpers:Translate strMatricula}" Style="{StaticResource TituloTela}" />
                <Label Text="{Binding TotalRegistros, StringFormat='{0} registro(s)'}" Style="{StaticResource LinhaApoio}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Nova matrícula" Style="{StaticResource BotaoNovo}"
                    VerticalOptions="Center" Command="{Binding AdicionarCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="170,*,Auto" ColumnSpacing="10" Padding="36,0,36,18"
              BackgroundColor="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}">
            <Picker Grid.Column="0" ItemsSource="{Binding TiposFiltro}" SelectedItem="{Binding FiltroSelecionado}" />
            <Entry Grid.Column="1" Placeholder="Digite o valor..." Text="{Binding TextoBusca}"
                   ReturnCommand="{Binding BuscarCommand}" />
            <Button Grid.Column="2" Text="{helpers:Translate strBuscar}" Style="{StaticResource BotaoSecundario}"
                    Padding="20,0" Command="{Binding BuscarCommand}" />
        </Grid>

        <BoxView Grid.Row="2" Style="{StaticResource Separador}" />

        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsRefreshing}" Command="{Binding AtualizarCommand}">
            <CollectionView ItemsSource="{Binding Matriculas}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="36,70" Spacing="8">
                        <Label Text="Nenhuma matrícula encontrada" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />
                        <Label Text="Ajuste o filtro acima ou registre a primeira matrícula."
                               Style="{StaticResource MetaDado}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:MatriculaDto">
                        <VerticalStackLayout>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Editar" BackgroundColor="{StaticResource Roxo}"
                                                   Command="{Binding BindingContext.EditarCommand, Source={x:Reference MatriculasPage}}"
                                                   CommandParameter="{Binding .}" />
                                        <SwipeItem Text="Excluir" BackgroundColor="{StaticResource Vermelho}"
                                                   Command="{Binding BindingContext.ExcluirCommand, Source={x:Reference MatriculasPage}}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid ColumnDefinitions="Auto,*,Auto,240,Auto,Auto" ColumnSpacing="24" Padding="36,14">

                                    <!-- Foto do aluno -->
                                    <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                        <Border Style="{StaticResource Avatar}"
                                                BackgroundColor="{Binding AlunoMatricula.Nome, Converter={StaticResource NomeParaCor}}">
                                            <Label Text="{Binding AlunoMatricula.Nome, Converter={StaticResource Iniciais}}"
                                                   Style="{StaticResource AvatarIniciais}" />
                                        </Border>
                                        <Border Style="{StaticResource Avatar}">
                                            <Image Source="{Binding AlunoMatricula.Foto, Converter={StaticResource FotoToImageSource}}"
                                                   Aspect="AspectFill" WidthRequest="44" HeightRequest="44" />
                                        </Border>
                                    </Grid>

                                    <!-- Aluno e objetivo -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding AlunoMatricula.Nome}" Style="{StaticResource NomePrincipal}" />
                                        <Label Text="{Binding Objetivo}" Style="{StaticResource MetaDado}" />
                                    </VerticalStackLayout>

                                    <!-- Vigência -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}" Style="{StaticResource MetaDado}" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding DataFim, StringFormat='até {0:dd/MM/yyyy}'}" Style="{StaticResource MetaDado}" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>

                                    <!-- Restrições médicas -->
                                    <VerticalStackLayout Grid.Column="3" Spacing="2" VerticalOptions="Center">
                                        <Label Text="RESTRIÇÕES" Style="{StaticResource RotuloSecao}" FontSize="9" />
                                        <Label Text="{Binding RestricoesMedicas, Converter={StaticResource RestricoesDisplay}}"
                                               Style="{StaticResource MetaDado}" />
                                    </VerticalStackLayout>

                                    <!-- Selo do plano -->
                                    <Border Grid.Column="4" Style="{StaticResource Etiqueta}" VerticalOptions="Center">
                                        <Label Text="{Binding Plano, Converter={StaticResource EnumDisplay}}" Style="{StaticResource EtiquetaTexto}" />
                                    </Border>

                                    <Button Grid.Column="5" Text="{helpers:Translate strEditar}"
                                            Style="{StaticResource BotaoTexto}" VerticalOptions="Center"
                                            Command="{Binding BindingContext.EditarCommand, Source={x:Reference MatriculasPage}}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </SwipeView>

                            <BoxView Style="{StaticResource Separador}" Margin="36,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
    </Grid>
</ContentPage>
