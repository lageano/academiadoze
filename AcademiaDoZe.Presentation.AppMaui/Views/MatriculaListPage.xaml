<?xml version="1.0" encoding="utf-8" ?>
<!-- gabriel geremias vieira -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaListPage"
             x:Name="MatriculasPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
             x:DataType="vm:MatriculaListViewModel"
             Title="{helpers:Translate strMatricula}">

    <!-- Recursos da Página -->
    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSource" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
        <converters:RestricoesFlagsDisplayConverter x:Key="RestricoesDisplay" />
    </ContentPage.Resources>

    <!-- Lista de Matrículas -->
    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="160,*" ColumnSpacing="10" Padding="16,14">
            <Picker Grid.Column="0" ItemsSource="{Binding TiposFiltro}" SelectedItem="{Binding FiltroSelecionado}" />
            <SearchBar Grid.Column="1" Placeholder="Digite o valor..."
                       Text="{Binding TextoBusca}" SearchCommand="{Binding BuscarCommand}" />
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding AtualizarCommand}">
            <CollectionView ItemsSource="{Binding Matriculas}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Label Text="Nenhuma matrícula encontrada." HorizontalOptions="Center" Margin="0,40"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:MatriculaDto">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Editar" BackgroundColor="{StaticResource Primary}"
                                               Command="{Binding BindingContext.EditarCommand, Source={x:Reference MatriculasPage}}"
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Excluir" BackgroundColor="{StaticResource DangerColor}"
                                               Command="{Binding BindingContext.ExcluirCommand, Source={x:Reference MatriculasPage}}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Style="{StaticResource CardBorder}" Margin="16,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">

                                        <!-- Nome do aluno -->
                                        <Label Text="{Binding AlunoMatricula.Nome}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" />

                                        <!-- CPF e nascimento -->
                                        <Label FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="CPF: " />
                                                    <Span Text="{Binding AlunoMatricula.Cpf}" />
                                                    <Span Text="  •  Nasc: " />
                                                    <Span Text="{Binding AlunoMatricula.DataNascimento, StringFormat='{0:dd/MM/yyyy}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <!-- Selo do plano -->
                                        <Border Style="{StaticResource BadgeBorder}">
                                            <Label Text="{Binding Plano, Converter={StaticResource EnumDisplay}}" Style="{StaticResource BadgeLabel}" />
                                        </Border>

                                        <!-- Vigência -->
                                        <Label FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Vigência: " FontAttributes="Bold" />
                                                    <Span Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}" />
                                                    <Span Text=" até " />
                                                    <Span Text="{Binding DataFim, StringFormat='{0:dd/MM/yyyy}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <!-- Objetivo -->
                                        <Label FontSize="11" LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Objetivo: " FontAttributes="Bold" />
                                                    <Span Text="{Binding Objetivo}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <!-- Restrições médicas -->
                                        <Label FontSize="11" LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Restrições: " FontAttributes="Bold" />
                                                    <Span Text="{Binding RestricoesMedicas, Converter={StaticResource RestricoesDisplay}}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <!-- Observações -->
                                        <Label Text="{Binding ObservacoesRestricoes, StringFormat='Obs: {0}'}" FontSize="10"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                                        <Button Text="{helpers:Translate strEditar}"
                                                Style="{StaticResource GhostPillButton}"
                                                HeightRequest="34" FontSize="11" Margin="0,6,0,0"
                                                Command="{Binding BindingContext.EditarCommand, Source={x:Reference MatriculasPage}}"
                                                CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>

                                    <!-- Foto do aluno -->
                                    <Border Grid.Column="1" WidthRequest="60" HeightRequest="60"
                                            StrokeThickness="0" VerticalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="30" />
                                        </Border.StrokeShape>
                                        <Image Source="{Binding AlunoMatricula.Foto, Converter={StaticResource FotoToImageSource}}"
                                               Aspect="AspectFill" WidthRequest="60" HeightRequest="60" />
                                    </Border>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="1" Text="+" Style="{StaticResource FabButton}" Command="{Binding AdicionarCommand}" />

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
    </Grid>
</ContentPage>
