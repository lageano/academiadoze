<?xml version="1.0" encoding="utf-8" ?>
<!-- gabriel geremias vieira -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
             x:DataType="vm:LogradouroViewModel"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <Grid RowDefinitions="Auto,1,*,1,Auto">

        <VerticalStackLayout Grid.Row="0" Padding="36,26,36,20" Spacing="3"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}">
            <Label Text="{Binding Title}" Style="{StaticResource TituloTela}" />
            <Label Text="Endereço base reutilizado por alunos e colaboradores." Style="{StaticResource LinhaApoio}" />
        </VerticalStackLayout>

        <BoxView Grid.Row="1" Style="{StaticResource Separador}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="36,26" Spacing="0" MaximumWidthRequest="760" HorizontalOptions="Start">

                <Label Text="IDENTIFICAÇÃO" Style="{StaticResource RotuloSecao}" />

                <Grid ColumnDefinitions="200,*" ColumnSpacing="20">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="CEP" Style="{StaticResource RotuloCampo}" />
                        <Entry Text="{Binding Logradouro.Cep}" Placeholder="00000000" Keyboard="Numeric" MaxLength="9" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="NOME DO LOGRADOURO" Style="{StaticResource RotuloCampo}" />
                        <Entry Text="{Binding Logradouro.Nome}" Placeholder="Rua, Avenida, Travessa..." />
                    </VerticalStackLayout>
                </Grid>

                <BoxView Style="{StaticResource Separador}" Margin="0,26" />

                <Label Text="LOCALIZAÇÃO" Style="{StaticResource RotuloSecao}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="BAIRRO" Style="{StaticResource RotuloCampo}" />
                        <Entry Text="{Binding Logradouro.Bairro}" Placeholder="Bairro" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="CIDADE" Style="{StaticResource RotuloCampo}" />
                        <Entry Text="{Binding Logradouro.Cidade}" Placeholder="Cidade" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="120,*" ColumnSpacing="20">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="ESTADO" Style="{StaticResource RotuloCampo}" />
                        <Entry Text="{Binding Logradouro.Estado}" Placeholder="UF" MaxLength="2" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="PAÍS" Style="{StaticResource RotuloCampo}" />
                        <Entry Text="{Binding Logradouro.Pais}" Placeholder="País" />
                    </VerticalStackLayout>
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Start" Margin="0,24,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <BoxView Grid.Row="3" Style="{StaticResource Separador}" />

        <!-- Barra de ações fixa no rodapé -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Padding="36,16"
              BackgroundColor="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}">
            <Button Grid.Column="1" Text="{helpers:Translate strCancelar}" WidthRequest="130"
                    Style="{StaticResource BotaoSecundario}" Command="{Binding CancelarCommand}" />
            <Button Grid.Column="2" Text="{helpers:Translate strSalvar}" WidthRequest="150"
                    Style="{StaticResource BotaoPrimario}"
                    IsEnabled="{Binding IsNotBusy}" Command="{Binding SalvarCommand}" />
        </Grid>
    </Grid>
</ContentPage>
