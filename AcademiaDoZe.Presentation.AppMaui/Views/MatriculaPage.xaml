<?xml version="1.0" encoding="utf-8" ?>
<!-- gabriel geremias vieira -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
             x:DataType="vm:MatriculaViewModel"
             Title=""
             Shell.NavBarIsVisible="{OnPlatform Default=True, WinUI=False}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSource" />
        <converters:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
        <converters:IniciaisConverter x:Key="Iniciais" />
        <converters:NomeParaCorConverter x:Key="NomeParaCor" />
        <converters:SemFotoConverter x:Key="SemFoto" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,1,*,1,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="{OnIdiom Phone='20,20,20,16', Default='36,26,36,20'}"
              BackgroundColor="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}">
            <VerticalStackLayout Grid.Column="0" Spacing="3">
                <Label Text="{Binding Title}" Style="{StaticResource TituloTela}" />
                <Label Text="Vincule o aluno, defina o plano e registre as condições de saúde." Style="{StaticResource LinhaApoio}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="{helpers:Translate strVoltar}"
                    Style="{StaticResource BotaoSecundario}" Padding="18,0"
                    VerticalOptions="Center" Command="{Binding CancelarCommand}" />
        </Grid>

        <BoxView Grid.Row="1" Style="{StaticResource Separador}" />

        <ScrollView Grid.Row="2">
            <Grid ColumnDefinitions="{OnIdiom Phone='*,0', Default='*,300'}" ColumnSpacing="40"
                  RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto,0'}"
                  Padding="{OnIdiom Phone='20,22', Default='36,26'}"
                  MaximumWidthRequest="1120" HorizontalOptions="Start">

                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="0" MaximumWidthRequest="720" HorizontalOptions="Start">

                    <!-- Aluno -->
                    <Label Text="ALUNO DA MATRÍCULA" Style="{StaticResource RotuloSecao}" />

                    <Label Text="CPF DO ALUNO" Style="{StaticResource RotuloCampo}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0" Text="{Binding CpfBusca}" Placeholder="Informe o CPF" Keyboard="Numeric" />
                        <Button Grid.Column="1" Text="Buscar" Style="{StaticResource BotaoPrimario}"
                                WidthRequest="120" Command="{Binding BuscarPorCpfCommand}" />
                    </Grid>

                    <Label Text="Nenhum aluno vinculado. Informe o CPF e clique em Buscar."
                           FontSize="12" Margin="0,10,0,0"
                           IsVisible="{Binding HasNoAlunoVinculado}"
                           TextColor="{StaticResource Vermelho}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,16,0,0"
                          IsVisible="{Binding HasAlunoVinculado}">
                        <Grid Grid.Column="0" WidthRequest="52" HeightRequest="52" VerticalOptions="Center">
                            <Border Style="{StaticResource Avatar}" WidthRequest="52" HeightRequest="52"
                                    BackgroundColor="{Binding Matricula.AlunoMatricula.Nome, Converter={StaticResource NomeParaCor}}">
                                <Label Text="{Binding Matricula.AlunoMatricula.Nome, Converter={StaticResource Iniciais}}"
                                       Style="{StaticResource AvatarIniciais}" FontSize="17" />
                            </Border>
                            <Border Style="{StaticResource Avatar}" WidthRequest="52" HeightRequest="52">
                                <Image Source="{Binding Matricula.AlunoMatricula.Foto, Converter={StaticResource FotoToImageSource}}"
                                       Aspect="AspectFill" WidthRequest="52" HeightRequest="52" />
                            </Border>
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Matricula.AlunoMatricula.Nome}" Style="{StaticResource NomePrincipal}" />
                            <Label Text="{Binding Matricula.AlunoMatricula.DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}"
                                   Style="{StaticResource MetaDado}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView Style="{StaticResource Separador}" Margin="0,26" />

                    <!-- Plano -->
                    <Label Text="PLANO E VIGÊNCIA" Style="{StaticResource RotuloSecao}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="PLANO" Style="{StaticResource RotuloCampo}" />
                            <Picker ItemsSource="{Binding PlanoTipos}" SelectedItem="{Binding Matricula.Plano, Mode=TwoWay}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="INÍCIO" Style="{StaticResource RotuloCampo}" />
                            <DatePicker Date="{Binding Matricula.DataInicio, Converter={StaticResource DateOnlyToDateTime}}" Format="dd/MM/yyyy" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="TÉRMINO" Style="{StaticResource RotuloCampo}" />
                            <DatePicker Date="{Binding Matricula.DataFim, Converter={StaticResource DateOnlyToDateTime}}" Format="dd/MM/yyyy" IsEnabled="False" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="OBJETIVO" Style="{StaticResource RotuloCampo}" />
                    <Entry Text="{Binding Matricula.Objetivo}" Placeholder="Ex.: Condicionamento físico" />

                    <BoxView Style="{StaticResource Separador}" Margin="0,26" />

                    <!-- Restrições médicas (enum Flags via CheckBoxes) -->
                    <Label Text="CONDIÇÕES DE SAÚDE" Style="{StaticResource RotuloSecao}" />
                    <Label Text="Marque as condições médicas diagnosticadas." Style="{StaticResource MetaDado}" Margin="0,4,0,12" />

                    <CollectionView ItemsSource="{Binding RestricoesMulti}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="2" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RestricaoSelectable">
                                <HorizontalStackLayout Spacing="8" Padding="0,5">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalOptions="Center" />
                                    <Label Text="{Binding Descricao}" VerticalOptions="Center" FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="OBSERVAÇÕES" Style="{StaticResource RotuloCampo}" />
                    <Editor Text="{Binding Matricula.ObservacoesRestricoes}"
                            Placeholder="Descreva observações relevantes sobre a saúde do aluno"
                            HeightRequest="90" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Start" Margin="0,24,0,0" />
                </VerticalStackLayout>

                <!-- Coluna do laudo -->
                <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}"
                                     Margin="{OnIdiom Phone='0,26,0,0', Default=0}" Spacing="14">
                    <Label Text="LAUDO MÉDICO" Style="{StaticResource RotuloSecao}" />

                    <Grid ColumnDefinitions="4,*" ColumnSpacing="12" IsVisible="{Binding LaudoPendente}">
                        <BoxView Grid.Column="0" Color="{StaticResource Vermelho}" VerticalOptions="Fill" />
                        <Label Grid.Column="1" FontSize="12" Padding="0,4"
                               Text="Aluno menor de 16 anos ou com restrições marcadas: o laudo é obrigatório."
                               TextColor="{StaticResource Vermelho}" />
                    </Grid>

                    <Grid ColumnDefinitions="4,*" ColumnSpacing="12" IsVisible="{Binding HasLaudo}">
                        <BoxView Grid.Column="0" Color="{StaticResource Verde}" VerticalOptions="Fill" />
                        <Label Grid.Column="1" Text="Laudo anexado." FontSize="12" Padding="0,4"
                               TextColor="{StaticResource Verde}" />
                    </Grid>

                    <Border WidthRequest="220" HeightRequest="220" StrokeThickness="1" HorizontalOptions="Start"
                            Stroke="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Image Source="{Binding Matricula.LaudoMedico, Converter={StaticResource FotoToImageSource}}"
                               Aspect="AspectFill" WidthRequest="220" HeightRequest="220" />
                    </Border>

                    <Button Text="Selecionar imagem" Style="{StaticResource BotaoSecundario}"
                            WidthRequest="220" HorizontalOptions="Start"
                            Command="{Binding SelecionarLaudoCommand}" />
                    <Button Text="Remover laudo" Style="{StaticResource BotaoTexto}"
                            HorizontalOptions="Start" IsVisible="{Binding HasLaudo}"
                            Command="{Binding RemoverLaudoCommand}" />
                </VerticalStackLayout>

            </Grid>
        </ScrollView>

        <BoxView Grid.Row="3" Style="{StaticResource Separador}" />

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Padding="{OnIdiom Phone='20,12', Default='36,16'}"
              BackgroundColor="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}">
            <Button Grid.Column="1" Text="{helpers:Translate strCancelar}" WidthRequest="130"
                    Style="{StaticResource BotaoSecundario}" Command="{Binding CancelarCommand}" />
            <Button Grid.Column="2" Text="{helpers:Translate strSalvar}" WidthRequest="150"
                    Style="{StaticResource BotaoPrimario}"
                    IsEnabled="{Binding IsNotBusy}" Command="{Binding SalvarCommand}" />
        </Grid>
    </Grid>
</ContentPage>
