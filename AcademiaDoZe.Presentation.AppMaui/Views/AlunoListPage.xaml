<?xml version="1.0" encoding="utf-8" ?>
<!-- gabriel geremias vieira -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AlunoListPage"
             x:Name="PaginaAlunos"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
             x:DataType="vm:AlunoListViewModel"
             Title=""
             Shell.NavBarIsVisible="{OnPlatform Default=True, WinUI=False}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSource" />
        <converters:IniciaisConverter x:Key="Iniciais" />
        <converters:NomeParaCorConverter x:Key="NomeParaCor" />
        <converters:CpfFormatadoConverter x:Key="CpfFormatado" />
        <converters:TelefoneFormatadoConverter x:Key="TelefoneFormatado" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,1,*">

        <!-- Cabeçalho com contagem e ação principal -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="{OnIdiom Phone='20,18,20,12', Default='36,26,36,16'}"
              BackgroundColor="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}">
            <VerticalStackLayout Grid.Column="0" Spacing="3">
                <Label Text="{helpers:Translate strAluno}" Style="{StaticResource TituloTela}" />
                <Label Text="{Binding TotalRegistros, StringFormat='{0} cadastrado(s)'}" Style="{StaticResource LinhaApoio}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Novo aluno" Style="{StaticResource BotaoNovo}"
                    VerticalOptions="Center" Command="{Binding AdicionarCommand}" />
        </Grid>

        <!-- Filtro -->
        <Grid Grid.Row="1" ColumnDefinitions="{OnIdiom Phone='110,*,Auto', Default='150,*,Auto'}" ColumnSpacing="10" Padding="{OnIdiom Phone='20,0,20,14', Default='36,0,36,18'}"
              BackgroundColor="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}">
            <Picker Grid.Column="0" ItemsSource="{Binding TiposFiltro}" SelectedItem="{Binding FiltroSelecionado}" />
            <Entry Grid.Column="1" Placeholder="Digite o valor..." Text="{Binding TextoBusca}"
                   ReturnCommand="{Binding BuscarCommand}" />
            <Button Grid.Column="2" Text="{helpers:Translate strBuscar}" Style="{StaticResource BotaoSecundario}"
                    Padding="20,0" Command="{Binding BuscarCommand}" />
        </Grid>

        <BoxView Grid.Row="2" Style="{StaticResource Separador}" />

        <!-- Linhas -->
        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsRefreshing}" Command="{Binding AtualizarCommand}">
            <CollectionView ItemsSource="{Binding Alunos}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="{OnIdiom Phone='20,50', Default='36,70'}" Spacing="8">
                        <Label Text="Nenhum aluno encontrado" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />
                        <Label Text="Ajuste o filtro acima ou cadastre o primeiro aluno."
                               Style="{StaticResource MetaDado}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:AlunoDto">
                        <VerticalStackLayout>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Editar" BackgroundColor="{StaticResource Roxo}"
                                                   Command="{Binding BindingContext.EditarCommand, Source={x:Reference PaginaAlunos}}"
                                                   CommandParameter="{Binding .}" />
                                        <SwipeItem Text="Excluir" BackgroundColor="{StaticResource Vermelho}"
                                                   Command="{Binding BindingContext.ExcluirCommand, Source={x:Reference PaginaAlunos}}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{OnIdiom Phone=10, Default=24}" Padding="{OnIdiom Phone='20,12', Default='36,14'}">

                                    <!-- Avatar com foto ou iniciais -->
                                    <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                        <Border Style="{StaticResource Avatar}"
                                                BackgroundColor="{Binding Nome, Converter={StaticResource NomeParaCor}}">
                                            <Label Text="{Binding Nome, Converter={StaticResource Iniciais}}"
                                                   Style="{StaticResource AvatarIniciais}" />
                                        </Border>
                                        <Border Style="{StaticResource Avatar}">
                                            <Image Source="{Binding Foto, Converter={StaticResource FotoToImageSource}}"
                                                   Aspect="AspectFill" WidthRequest="44" HeightRequest="44" />
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Nome}" Style="{StaticResource NomePrincipal}" />
                                        <Label Text="{Binding Email}" Style="{StaticResource MetaDado}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center" HorizontalOptions="End"
                                                         IsVisible="{OnIdiom Phone=False, Default=True}">
                                        <Label Text="{Binding Cpf, Converter={StaticResource CpfFormatado}}"
                                               Style="{StaticResource MetaDado}" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding Telefone, Converter={StaticResource TelefoneFormatado}}"
                                               Style="{StaticResource MetaDado}" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="3" Text="{helpers:Translate strEditar}"
                                            Style="{StaticResource BotaoTexto}" VerticalOptions="Center"
                                            Command="{Binding BindingContext.EditarCommand, Source={x:Reference PaginaAlunos}}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </SwipeView>

                            <BoxView Style="{StaticResource Separador}" Margin="{OnIdiom Phone='20,0', Default='36,0'}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
    </Grid>
</ContentPage>
