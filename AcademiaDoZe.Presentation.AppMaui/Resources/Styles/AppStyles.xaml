<?xml version="1.0" encoding="UTF-8" ?>
<!-- gabriel geremias vieira -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta -->
    <Color x:Key="Ink">#12101C</Color>
    <Color x:Key="InkSoft">#5B5770</Color>
    <Color x:Key="Canvas">#FAF9FD</Color>
    <Color x:Key="CanvasDark">#111018</Color>
    <Color x:Key="Panel">#FFFFFF</Color>
    <Color x:Key="PanelDark">#1B1926</Color>
    <Color x:Key="Hairline">#E6E2F0</Color>
    <Color x:Key="HairlineDark">#2C2940</Color>
    <Color x:Key="Roxo">#6D4AFF</Color>
    <Color x:Key="RoxoFundo">#2B1D63</Color>
    <Color x:Key="Dourado">#FFC107</Color>
    <Color x:Key="Verde">#1F8A4C</Color>
    <Color x:Key="Vermelho">#C0392B</Color>

    <!-- Tipografia: a hierarquia vem do tamanho e do peso, não de caixas -->
    <Style x:Key="TituloTela" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
    </Style>

    <Style x:Key="LinhaApoio" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />
    </Style>

    <!-- Rótulo de seção em caixa alta, com tracking largo -->
    <Style x:Key="RotuloSecao" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.6" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />
    </Style>

    <Style x:Key="NomePrincipal" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
    </Style>

    <Style x:Key="MetaDado" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />
    </Style>

    <Style x:Key="RotuloCampo" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="Margin" Value="0,14,0,4" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />
    </Style>

    <!-- Linha fina de separação entre itens, no lugar de empilhar bordas -->
    <Style x:Key="Separador" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />
    </Style>

    <!-- Painel usado só onde realmente agrupa conteúdo -->
    <Style x:Key="Painel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Avatar circular com iniciais, usado quando não há foto -->
    <Style x:Key="Avatar" TargetType="Border">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <Ellipse />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AvatarIniciais" TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Etiqueta discreta: contorno em vez de preenchimento -->
    <Style x:Key="Etiqueta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="{StaticResource Roxo}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EtiquetaTexto" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Roxo}, Dark={StaticResource Dourado}}" />
    </Style>

    <!-- Botões: cantos discretos, não pílulas -->
    <Style x:Key="BotaoPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Roxo}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="BotaoSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="BotaoTexto" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Roxo}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style x:Key="BotaoNovo" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Roxo}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F1EEFA, Dark=#15131F}" />
    </Style>

    <!-- Sem esse fundo o Picker fica sem contorno visível no tema claro -->
    <Style TargetType="Picker">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F1EEFA, Dark=#15131F}" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F1EEFA, Dark=#15131F}" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F1EEFA, Dark=#15131F}" />
    </Style>

    <!-- Barra do Shell discreta: cada tela ja tem o proprio cabecalho -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.FlyoutBackgroundColor" Value="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource Panel}, Dark={StaticResource PanelDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Roxo}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Roxo}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource Gray400}}" />
    </Style>

</ResourceDictionary>
